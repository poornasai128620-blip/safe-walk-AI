# ==============================================================================
# SAFEWALK AI — Production-Grade Environment Configuration
# ==============================================================================
# NOTE: Never store production secrets or API keys in client-side bundles.
# Server-side variables remain strictly within the Node.js backend.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
WEB_APP_URL=http://localhost:5173
MOBILE_APP_SCHEME=safewalkai

# Supabase PostgreSQL & Auth (Optional in mock/in-memory mode; mandatory in production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
JWT_ISSUER=https://your-project.supabase.co/auth/v1

# OpenAI Integration (Official Node SDK)
# Used server-side for voice emergency phrase verification & incident categorization
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# Mapping & Geolocation Providers
GOOGLE_MAPS_API_KEY=AIzaSy...

# Push Notifications (Firebase Admin Cloud Messaging)
FIREBASE_PROJECT_ID=safewalk-ai-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@safewalk-ai-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...-----END PRIVATE KEY-----\n"

# SMS & Voice Dispatch Provider (Twilio / AWS SNS / MSG91)
SMS_PROVIDER=mock
SMS_API_KEY=

# Email Emergency Dispatch Provider (SendGrid / Resend)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=

# Evidence Retention & Storage
EVIDENCE_STORAGE_BUCKET=emergency-evidence
MAX_EVIDENCE_FILE_SIZE_MB=50
EVIDENCE_RETENTION_DAYS=30

# Emergency 112 India Integration Mode ('mock' for dev, 'production' with signed certificates)
EMERGENCY_INTEGRATION_MODE=mock

# CCTV Infrastructure Provider Mode ('mock' for dev with synthetic cameras, 'authorized_adapter')
CCTV_INTEGRATION_MODE=mock
